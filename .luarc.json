{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.1",
  "runtime.nonstandardSymbol": [],
  "diagnostics.disable": [
    "undefined-global",
    "lowercase-global",
    "undefined-field",
    "deprecated"
  ],
  "diagnostics.globals": [
    "ElvUI", "OctoUI", "LibStub", "AtlasCFM",
    "this", "arg1", "arg2", "arg3", "arg4", "arg5", "arg6", "arg7", "arg8", "arg9",
    "event", "getfenv", "setfenv", "unpack", "getn", "tinsert", "tremove", "wipe",
    "hooksecurefunc", "HookScript", "CreateFrame", "UIParent", "GameTooltip"
  ],
  "workspace.ignoreDir": [
    ".git",
    ".claude",
    "Libraries"
  ],
  "workspace.maxPreload": 6000,
  "workspace.preloadFileSize": 2000
}
